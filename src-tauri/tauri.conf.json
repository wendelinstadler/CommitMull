{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CommitMull",
  "version": "0.1.0",
  "identifier": "de.wendelinstadler.commitmull",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "hub",
        "title": "CommitMull Hub",
        "url": "index.html?hub",
        "width": 100,
        "height": 100,
        "visible": false,
        "focus": false,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "home",
        "title": "CommitMull",
        "url": "index.html?home",
        "width": 720,
        "height": 560,
        "minWidth": 520,
        "minHeight": 400,
        "center": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "CommitMull Einstellungen",
        "url": "index.html?settings",
        "width": 840,
        "height": 680,
        "center": true,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      },
      {
        "label": "ghost",
        "title": "CommitMull Vorschau",
        "url": "index.html?ghost",
        "width": 170,
        "height": 190,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
